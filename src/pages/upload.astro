---
// Band-only shortcut page (not in the menu, hidden from search engines).
// Save it to your phone's home screen for quick photo uploads.
import Base from '../layouts/Base.astro';

const repo = 'https://github.com/bellafairebrothers/bellafaire-brothers-website';
---
<Base title="Upload photos" bare>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <div class="upload-page">
    <h1>Upload photos</h1>
    <p class="muted">For the band only. You'll need to be signed in to GitHub.</p>

    <section>
      <h2>Photos page</h2>
      <p>Everything you upload here shows on the Photos page automatically, newest first.</p>
      <a class="btn btn-primary" href={`${repo}/upload/main/src/assets/photos`} target="_blank" rel="noopener">
        Upload to Photos page
      </a>
    </section>

    <section>
      <h2>Merch, band & member photos</h2>
      <ol>
        <li>Upload the photos here.</li>
        <li>Open the editor, go to the item (e.g. a merch item), tap its photo field and choose the photo you uploaded. Don't use the editor's upload button; it can't handle big photos.</li>
      </ol>
      <div class="actions">
        <a class="btn btn-primary" href={`${repo}/upload/main/src/assets/uploads`} target="_blank" rel="noopener">
          1. Upload photos
        </a>
        <a class="btn" href="https://app.pagescms.org" target="_blank" rel="noopener">2. Open the editor</a>
      </div>
    </section>

    <p class="muted small">
      Select as many photos as you like, then tap <strong>Commit changes</strong>. Full-size and iPhone (HEIC) photos are
      fine, up to 25 MB each. The site updates about a minute later.
    </p>
    <a class="text-link" href="/">← Back to the site</a>
  </div>
</Base>

<style>
  .upload-page {
    max-width: 560px;
    margin: 0 auto;
    padding: 48px 16px;
  }
  h1 {
    font-size: 2.2rem;
  }
  section {
    margin-top: 28px;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
  }
  h2 {
    font-size: 1.3rem;
  }
  ol {
    padding-left: 1.2em;
  }
  li {
    margin-bottom: 8px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .btn {
    width: 100%;
  }
  .small {
    margin-top: 24px;
    font-size: 0.9rem;
  }
</style>
