---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { execFileSync } from 'node:child_process';
import type { ImageMetadata } from 'astro';
import { settings } from '../lib/content';

// Every photo in src/assets/photos appears here. Upload them in bulk on GitHub
// (see README) or one at a time through the Pages CMS "Photos page" media library.
const files = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/photos/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}',
  { eager: true },
);

// Newest first, by when each photo was added to the repository. iPhone HEIC photos are
// converted to JPG during the GitHub build, so those use the original .heic file's date.
function addedAt(path: string): number {
  const file = path.slice(1);
  const base = file.replace(/\.[^.]+$/, '');
  for (const candidate of [file, `${base}.heic`, `${base}.HEIC`]) {
    try {
      const out = execFileSync('git', ['log', '--diff-filter=A', '--format=%ct', '-1', '--', candidate], {
        encoding: 'utf8',
      }).trim();
      if (out) return Number(out);
    } catch {
      return 0;
    }
  }
  return Date.now() / 1000;
}

const sorted = Object.entries(files)
  .map(([path, mod]) => ({ path, meta: mod.default, added: addedAt(path) }))
  .sort((a, b) => b.added - a.added || b.path.localeCompare(a.path));

const photos = await Promise.all(
  sorted.map(async ({ meta }) => ({
    meta,
    full: (await getImage({ src: meta, width: Math.min(2000, meta.width), format: 'webp' })).src,
  })),
);
---
<Base title="Photos" description={`Photos of ${settings.bandName}.`}>
  <div class="container page-header">
    <p class="eyebrow">Gallery</p>
    <h1>Photos</h1>
  </div>
  <section class="section">
    <div class="container">
      {photos.length > 0 ? (
        <div class="gallery">
          {photos.map((p) => (
            <a href={p.full} class="thumb">
              <Image src={p.meta} alt={`${settings.bandName} photo`} widths={[400, 800]} sizes="(max-width: 700px) 50vw, 33vw" />
            </a>
          ))}
        </div>
      ) : (
        <p class="empty">Photos coming soon.</p>
      )}
    </div>
  </section>

  <dialog class="lightbox" aria-label="Photo viewer">
    <img alt="" />
    <button type="button" class="lb-close" aria-label="Close">×</button>
    <button type="button" class="lb-prev" aria-label="Previous photo">‹</button>
    <button type="button" class="lb-next" aria-label="Next photo">›</button>
  </dialog>
</Base>

<style>
  .gallery {
    columns: 3 240px;
    column-gap: 10px;
  }
  @media (max-width: 600px) {
    .gallery {
      columns: 2;
      column-gap: 6px;
    }
    .thumb {
      margin-bottom: 6px;
    }
  }
  .thumb {
    display: block;
    margin-bottom: 10px;
    break-inside: avoid;
    border-radius: 6px;
    overflow: hidden;
  }
  .thumb img {
    width: 100%;
    height: auto;
    transition: opacity 0.2s;
  }
  .thumb:hover img {
    opacity: 0.85;
  }
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(0, 0, 0, 0.94);
    color: var(--text);
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
  }
  .lightbox img {
    max-width: 92vw;
    max-height: 88dvh;
    object-fit: contain;
  }
  .lightbox button {
    position: absolute;
    background: none;
    border: 0;
    color: var(--text);
    font-size: 2.6rem;
    width: 56px;
    height: 56px;
    cursor: pointer;
  }
  .lb-close {
    top: 8px;
    right: 8px;
  }
  .lb-prev {
    left: 4px;
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-next {
    right: 4px;
    top: 50%;
    transform: translateY(-50%);
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const img = dialog.querySelector('img')!;
  const thumbs = [...document.querySelectorAll<HTMLAnchorElement>('.thumb')];
  let index = 0;

  function show(i: number) {
    index = (i + thumbs.length) % thumbs.length;
    img.src = thumbs[index].href;
  }

  thumbs.forEach((thumb, i) =>
    thumb.addEventListener('click', (e) => {
      e.preventDefault();
      show(i);
      dialog.showModal();
    }),
  );
  dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog.close());
  dialog.querySelector('.lb-prev')!.addEventListener('click', () => show(index - 1));
  dialog.querySelector('.lb-next')!.addEventListener('click', () => show(index + 1));
  dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());
  document.addEventListener('keydown', (e) => {
    if (!dialog.open) return;
    if (e.key === 'ArrowLeft') show(index - 1);
    if (e.key === 'ArrowRight') show(index + 1);
  });

  // Swipe left/right on phones.
  let startX = 0;
  dialog.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
  dialog.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - startX;
    if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
  });
</script>
