---
// Link-in-bio page (replaces Linktree). Point the Instagram bio link here.
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { settings, linksPage, getActiveLinks } from '../lib/content';
import badge from '../assets/brand/sunset-cliffs-badge.png';
import { localImage, remoteImage } from '../lib/images';
import { getReleases } from '../lib/spotify';
import { getVideos } from '../lib/youtube';
import { getUpcomingShows, formatShowDate } from '../lib/bandsintown';
import SocialLinks from '../components/SocialLinks.astro';
import Icon from '../components/Icon.astro';

const profile = await getImage({ src: localImage(linksPage.profileImage) ?? badge, width: 240, height: 240, fit: 'cover', format: 'webp' });

const [releases, videos, shows] = await Promise.all([getReleases(), getVideos(), getUpcomingShows()]);
const release = linksPage.showLatestRelease ? releases[0] : undefined;
const video = linksPage.showLatestVideo ? videos[0] : undefined;
const show = linksPage.showNextShow ? shows[0] : undefined;
const [releaseCover, videoThumb] = await Promise.all([
  remoteImage(release?.image, 160),
  remoteImage(video?.thumbnail, 240),
]);
const showDate = show ? formatShowDate(show.datetime) : undefined;
const links = getActiveLinks();
---
<Base title="Links" bare>
  <div class="links-page">
    <header>
      <img class="avatar" src={profile.src} alt="" width="120" height="120" />
      <h1>{settings.bandName}</h1>
      {linksPage.tagline && <p class="muted">{linksPage.tagline}</p>}
    </header>

    <ul class="links">
      {release && (
        <li>
          <a class="link feature" href={release.spotifyUrl} target="_blank" rel="noopener">
            {releaseCover && <img src={releaseCover} alt="" width="56" height="56" />}
            <span>
              <small>New {release.type.toLowerCase()}</small>
              {release.name}
            </span>
          </a>
        </li>
      )}
      {video && (
        <li>
          <a class="link feature" href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" rel="noopener">
            {videoThumb && <img src={videoThumb} alt="" width="56" height="56" class="video-thumb" />}
            <span>
              <small>Latest music video</small>
              {video.title}
            </span>
          </a>
        </li>
      )}
      {show && showDate && (
        <li>
          <a class="link feature" href={show.ticketUrl ?? show.eventUrl} target="_blank" rel="noopener">
            <span class="date-chip"><b>{showDate.month}</b>{showDate.day}</span>
            <span>
              <small>Next show</small>
              {show.venue}, {show.city}
            </span>
          </a>
        </li>
      )}
      {links.map((l) => {
        const external = /^https?:/.test(l.url);
        return (
          <li>
            <a
              class:list={['link', { highlight: l.highlight }]}
              href={l.url}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener' : undefined}
            >
              <span>{l.label}</span>
            </a>
          </li>
        );
      })}
    </ul>

    <footer>
      <SocialLinks size={24} />
      <a href="/" class="home-link">bellafaire brothers <Icon name="arrow" size={14} /></a>
    </footer>
  </div>
</Base>

<style>
  .links-page {
    max-width: 560px;
    margin: 0 auto;
    padding: 48px 16px 40px;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }
  header {
    text-align: center;
    margin-bottom: 28px;
  }
  .avatar {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    margin: 0 auto 16px;
    object-fit: cover;
  }
  h1 {
    font-size: 2rem;
    margin-bottom: 4px;
  }
  header p {
    margin: 0;
  }
  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-height: 60px;
    padding: 12px 20px;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: var(--surface);
    text-decoration: none;
    font-weight: 600;
    text-align: center;
    transition: border-color 0.15s, transform 0.15s, background 0.15s;
  }
  .link:hover {
    border-color: var(--sunset);
    transform: translateY(-1px);
  }
  .link.highlight {
    background: var(--sunset);
    border-color: var(--sunset);
    color: #120c08;
  }
  .link.feature {
    justify-content: flex-start;
    text-align: left;
    padding: 8px 16px 8px 8px;
  }
  .link.feature img {
    width: 56px;
    height: 56px;
    border-radius: 8px;
    object-fit: cover;
    flex-shrink: 0;
  }
  .link small {
    display: block;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--sunset);
  }
  .date-chip {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    border-radius: 8px;
    background: var(--surface-2);
    font-family: var(--font-display);
    font-size: 1.4rem;
    line-height: 1;
  }
  .date-chip b {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sunset);
  }
  footer {
    margin-top: auto;
    padding-top: 36px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .home-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.8rem;
    text-decoration: none;
  }
</style>
