---
import type { Release } from '../lib/spotify';
import { remoteImage } from '../lib/images';

interface Props {
  release: Release;
}
const { release } = Astro.props;
const cover = await remoteImage(release.image, 600);
const year = release.releaseDate.slice(0, 4);
---
<article class="card release">
  <a href={release.spotifyUrl} target="_blank" rel="noopener" class="cover">
    {cover && <img src={cover} alt={`${release.name} cover art`} loading="lazy" decoding="async" />}
  </a>
  <div class="card-body">
    <p class="meta">{release.type} · {year}</p>
    <h3>{release.name}</h3>
    <div class="listen">
      <a class="btn btn-small btn-primary" href={release.spotifyUrl} target="_blank" rel="noopener">Spotify</a>
      {release.links.map((l) => (
        <a class="btn btn-small" href={l.url} target="_blank" rel="noopener">{l.label}</a>
      ))}
    </div>
  </div>
</article>

<style>
  .cover img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .meta {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0 0 4px;
  }
  h3 {
    margin-bottom: 14px;
  }
  .listen {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
</style>
