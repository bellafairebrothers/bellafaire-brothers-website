---
// Simple line icons (no external icon library needed).
interface Props {
  name: string;
  size?: number;
}
const { name, size = 22 } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'instagram' && (
    <Fragment>
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
    </Fragment>
  )}
  {name === 'spotify' && (
    <Fragment>
      <circle cx="12" cy="12" r="9.5" />
      <path d="M7 9.5c3.5-1 7.5-.7 10.5 1" />
      <path d="M7.6 12.6c2.9-.8 6-.5 8.6.9" />
      <path d="M8.2 15.5c2.3-.6 4.6-.4 6.6.7" />
    </Fragment>
  )}
  {name === 'youtube' && (
    <Fragment>
      <rect x="2.5" y="5.5" width="19" height="13" rx="4" />
      <path d="M10.5 9.5v5l4.5-2.5z" fill="currentColor" />
    </Fragment>
  )}
  {name === 'facebook' && <path d="M14 8h3V4.5h-3c-2.2 0-4 1.8-4 4V11H7.5v3.5H10V21h3.5v-6.5h3l.5-3.5h-3.5V8.8c0-.5.3-.8.5-.8z" />}
  {(name === 'appleMusic' || name === 'tiktok' || name === 'music') && (
    <Fragment>
      <path d="M9 18V6l11-2v12" />
      <circle cx="6.5" cy="18" r="2.5" />
      <circle cx="17.5" cy="16" r="2.5" />
    </Fragment>
  )}
  {name === 'bandsintown' && (
    <Fragment>
      <rect x="3.5" y="5" width="17" height="15" rx="2" />
      <path d="M3.5 10h17M8 3v4M16 3v4" />
    </Fragment>
  )}
  {name === 'mail' && (
    <Fragment>
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="m3.5 6.5 8.5 6 8.5-6" />
    </Fragment>
  )}
  {name === 'play' && <path d="M8 5.5v13l10.5-6.5z" fill="currentColor" stroke="none" />}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'ticket' && (
    <Fragment>
      <path d="M4 8a2 2 0 0 0 0 4v4h16v-4a2 2 0 0 1 0-4V4H4z" transform="translate(0 2)" />
    </Fragment>
  )}
</svg>
