---
import { settings } from '../lib/content';
import Icon from './Icon.astro';

interface Props {
  size?: number;
}
const { size = 22 } = Astro.props;

const labels: Record<string, string> = {
  instagram: 'Instagram',
  spotify: 'Spotify',
  youtube: 'YouTube',
  appleMusic: 'Apple Music',
  bandsintown: 'Bandsintown',
  tiktok: 'TikTok',
  facebook: 'Facebook',
};
const links = Object.entries(settings.social).filter(([, url]) => url);
---
<ul class="social">
  {links.map(([key, url]) => (
    <li>
      <a href={url} target="_blank" rel="noopener" aria-label={labels[key] ?? key} title={labels[key] ?? key}>
        <Icon name={key} size={size} />
      </a>
    </li>
  ))}
</ul>

<style>
  .social {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: var(--muted);
    transition: color 0.15s, background 0.15s;
  }
  a:hover {
    color: var(--text);
    background: var(--surface-2);
  }
</style>
